    {
      "parameters": {
        "jsCode": "// Tomamos los resultados del nodo de Tavily\nconst results = $input.first().json.results || [];\n\nif (results.length === 0) {\n  return [{ json: { summary_message: \"No se encontraron ofertas que coincidan hoy.\" } }];\n}\n\nlet message = \"🚀 **Nuevas ofertas de trabajo encontradas:** \\n\\n \";\n\nresults.forEach((job, index) => {\n  // Limpiamos el título por si trae espacios raros\n  const title = job.title ? job.title.trim() : \"Oferta de trabajo\";\n  const url = job.url;\n  \n  message += ` ${index + 1}. **${title}** \\n 🔗 ${url} \\n\\n `;\n});\n\nreturn [{\n  json: {\n    summary_message: message.trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
